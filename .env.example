TMR_SERVER_USER=<server-user>
TMR_SERVER_HOST=<server-host>
TMR_SERVER_PORT=22
TMR_SERVER_ROOT=/path/to/server/repo

AUBO_ROBOT_IP=<robot-controller-ip>
AUBO_RPC_PORT=30005
AUBO_RTDE_PORT=9012
AUBO_RPC_USER=<controller-user>
AUBO_RPC_PASSWORD=<controller-password>

TMR_GRIPPER_DO_INDEX=1
TMR_GRIPPER_DO_CLOSE_VALUE=true
TMR_GRIPPER_DO_OPEN_VALUE=false

WRIST_REALSENSE_SERIAL=<optional-camera-serial>
TMR_CLIENT_RUN_ROOT=~/tool_manipulation_runs

# Optional model and external repository locations on the inference server.
YOLOWORLD_WEIGHTS=/path/to/yoloworld.pt
SAM_CHECKPOINT=/path/to/sam_or_sam2_checkpoint.pt
SEEDFORMER_CHECKPOINT=/path/to/completion_checkpoint.pth
DGCNN_CHECKPOINT=/path/to/affordance_segmentation_checkpoint.pth
CONTACT_GRASPNET_ROOT=/path/to/contact_graspnet_pytorch
CONTACT_GRASPNET_PYTHON=python
FULL_PIPELINE_PYTHON=python
FULL_PIPELINE_DEVICE=cuda:0

# Optional Python module that implements:
# run_completion_affordance(partial_norm: np.ndarray, args: argparse.Namespace) -> dict
# When unset, the release uses a deterministic geometric fallback and marks it
# explicitly in completion_segmentation_summary.json.
COMPLETION_AFFORDANCE_BACKEND=
